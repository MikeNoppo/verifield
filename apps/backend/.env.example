# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua nilai di bawah bisa ditimpa lewat environment variable.

# ---------- Aplikasi ----------
APP_NAME=verifield-be
APP_ENV=development            # development | production
APP_DEBUG=true
# Zona waktu operasi lapangan (asumsi A-04). Dipakai aturan jam kerja pada
# penjadwalan; penyimpanan tetap UTC.
APP_TIMEZONE=Asia/Jakarta

# ---------- HTTP ----------
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_ALLOWED_ORIGINS=*

# ---------- Database (PostgreSQL) ----------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=verifield
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_LOG_LEVEL=warn              # silent | error | warn | info

# ---------- Migrasi ----------
# Dev database untuk Atlas: WAJIB database KOSONG dan terpisah dari DB_NAME.
# Atlas membuat & menghapus objek di sini untuk menghitung diff schema.
# Siapkan sekali dengan: createdb verifield_dev
# Hanya dipakai saat `make migrate-diff`; tidak diperlukan di production.
ATLAS_DEV_URL=postgres://postgres:postgres@localhost:5432/verifield_dev?sslmode=disable&search_path=public

# ---------- Seeder ----------
# Dipakai `make seed` untuk membuat admin pertama.
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@verifield.id
SEED_ADMIN_PASSWORD=
